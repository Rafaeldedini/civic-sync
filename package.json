{
  "name": "civic-sync",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared/*",
    "services/*"
  ],
  "scripts": {
    "dev:ingestion": "npm run dev --workspace=services/ingestion",
    "dev:ingestion-a": "cross-env PORT=3001 INSTANCE_ID=A npm run dev --workspace=services/ingestion",
    "dev:ingestion-b": "cross-env PORT=3002 INSTANCE_ID=B npm run dev --workspace=services/ingestion",
    "dev:gateway": "npm run dev --workspace=services/gateway",
    "dev:persistence": "npm run dev --workspace=services/persistence",
    "dev:processing": "npm run dev --workspace=services/processing",
    "dev": "concurrently \"npm run dev:ingestion\" \"npm run dev:persistence\" \"npm run dev:processing\"",
    "dev:ha": "concurrently \"npm run dev:ingestion-a\" \"npm run dev:ingestion-b\" \"npm run dev:gateway\" \"npm run dev:persistence\" \"npm run dev:processing\"",
    "dashboard": "npx serve . -p 8080 -s",
    "start:all": "concurrently \"npm run dev\" \"npm run dashboard\"",
    "start:ha": "concurrently \"npm run dev:ha\" \"npm run dashboard\"",
    "mock": "npx tsx scripts/mock-sensor.ts",
    "mock:crisis": "npx tsx scripts/mock-sensor.ts --crisis",
    "db:migrate": "npm run db:migrate  --workspace=shared/database",
    "db:generate": "npm run db:generate --workspace=shared/database",
    "db:studio": "npm run db:studio   --workspace=shared/database"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vercel": "^54.9.1"
  }
}
